# =========================================
# Archivos y carpetas de Visual Studio / IDEs
# =========================================
.vs/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.RiderPreferences

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# =========================================
# Paquetes de NuGet
# =========================================
*.nupkg
# Ignorar la carpeta de paquetes locales (Restore)
**/[Pp]ackages/*
!**/[Pp]ackages/build/
# Archivos autogenerados por NuGet
*.nuget.props
*.nuget.targets

# =========================================
# Archivos de caché de ASP.NET Core
# =========================================
appsettings.Development.json
appsettings.Local.json

# =========================================
# Archivos generados por el Sistema Operativo
# =========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# =========================================
# Específicos de Visual Basic (VB.NET)
# =========================================
# Archivos de configuración de usuario específicos de VB
*.vbproj.user

# Carpetas temporales generadas al actualizar o respaldar proyectos antiguos de VB
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# =========================================
# Publicación, Pruebas y Base de Datos
# =========================================
# Perfiles de publicación (evita subir contraseñas de servidores)
*.pubxml.user
*.publishproj

# Resultados de pruebas unitarias (si testean el backend o frontend)
[Tt]est[Rr]esult*/
[Tt]est[Rr]esults/
*.coverage
*.coveragexml

# Archivos de bases de datos locales (si usan LocalDB para pruebas)
*.mdf
*.ldf
*.ndf

# =========================================
# Frontend Web (Opcional)
# =========================================
# Si el frontend en VB o la solución utiliza librerías de cliente (npm, libman)
node_modules/
dist/
